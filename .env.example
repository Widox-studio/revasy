# ==============================================================================
# revasy Environment Configuration (.env.local)
# ==============================================================================

# 1. Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Clerk Authentication (Merchant Dashboard Access)
# Obtain from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 3. Google OAuth 2.0 (Google Business Profile Live Sync & Auto-Reply)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Whitelisted Pilot Accounts (comma-separated Gmails)
WHITELISTED_EMAILS=riteshch.dev@gmail.com,advertising.coral@gmail.com,owner@cocovacafe.com

# 4. AI Models & Fallback Engine
# The system executes in cascading fallback order:
# Cloudflare Workers AI -> Groq -> Google Gemini -> OpenRouter -> OpenAI -> Template Engine

# Cloudflare Workers AI (Edge LLM & revasy-api worker: https://dash.cloudflare.com)
CLOUDFLARE_WORKER_URL=https://revasy-api.widoxstudio.workers.dev
CLOUDFLARE_ACCOUNT_ID=38d1ceb6731de305dc93daf3659e371c
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct

# Groq Cloud API (Free & ultra-fast inference: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API (Universal AI Gateway: https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI API (Optional: https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 5. Cloudflare R2 Storage (For Business Logos & Stand QR Assets)
# R2 Bucket binding is automatically connected in Cloudflare Workers / Pages
R2_PUBLIC_DOMAIN=

# 6. Legacy / Merchant Fallback Admin Credentials
ADMIN_EMAIL=owner@cocovacafe.com
ADMIN_PASSWORD=CocovaSecure2026!
SESSION_SECRET=revasy-session-secret-change-in-production-2026-xyz

# 7. Demo Business Google Review URL
COCOVA_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJaS8pZMdn4DsRrA8wg4kapzo
